  "query": "SELECT COALESCE(NULLIF(ii.line_name, ''), p.name) AS \"name!: String\", p.unit AS unit,\n                ii.quantity, ii.unit_price,\n                ii.subtotal, ii.discount, ii.vat_rate\n           FROM invoice_item ii\n           JOIN product p ON p.id = ii.product_id\n          WHERE ii.invoice_id = ?\n          ORDER BY ii.id",
