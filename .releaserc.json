{
  "$schema": "https://json.schemastore.org/semantic-release",
  "branches": ["main"],
  "tagFormat": "v${version}",
  "initialVersion": "0.3.0",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "build", "release": "patch" },
          { "type": "chore", "scope": "deps", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": null, "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Tính năng mới" },
            { "type": "fix", "section": "Sửa lỗi" },
            { "type": "perf", "section": "Hiệu năng" },
            { "type": "refactor", "section": "Tái cấu trúc" },
            { "type": "build", "section": "Build / phụ thuộc" },
            { "type": "docs", "section": "Tài liệu" },
            { "type": "test", "section": "Kiểm thử" },
            { "type": "chore", "section": "Việc vặt" }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog"
      }
    ],
    [
      "@semantic-release/exec",
      { "prepareCmd": "node scripts/set-version.mjs ${nextRelease.version}" }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "src-tauri/tauri.conf.json",
          "src-tauri/Cargo.toml",
          "src-tauri/Cargo.lock"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "releaseDraft": true,
        "successComment": false,
        "failComment": false,
        "labels": ["release"]
      }
    ]
  ]
}
