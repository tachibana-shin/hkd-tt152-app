  "query": "SELECT ii.id, ii.invoice_id, p.code AS product_code, p.name AS product_name,\n                p.unit, ii.quantity, ii.unit_price, ii.subtotal\n         FROM invoice_item ii\n         JOIN product p ON p.id = ii.product_id\n         WHERE ii.invoice_id = ?\n         ORDER BY ii.id",
